#!/bin/sh
# Reject tool / vendor attribution trailers. Authorship lines are added only by the human author.
if grep -i -E '^(co-authored-by|generated-with|[a-z-]*session):' "$1" >/dev/null 2>&1; then
  echo "commit-msg: attribution or session trailer found - remove it (see AGENTS.md)" >&2
  exit 1
fi
if grep -i -E 'generated with \[' "$1" >/dev/null 2>&1; then
  echo "commit-msg: tool attribution line found - remove it (see AGENTS.md)" >&2
  exit 1
fi
